# --- AI / LLM Configuration (Chatbot & Document Assistant) ---------------------------
# Provider Options: openrouter (default), groq, gemini, or openai-compatible.
# Configured in ONE place: switch provider or model without code changes.

# Option A: OpenRouter (recommended default)
LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.3

# Option B: Groq (ultra fast inference)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Option C: Google Gemini
# GEMINI_API_KEY=AIza_your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# --- Translation (see docs/TRANSLATION.md) --------------------------------------------

# IndicTrans2
INDICTRANS_URL=http://localhost:8001/translate
INDICTRANS_TOKEN=

# Translation priority
TRANSLATION_PROVIDERS=indictrans,llm,argos
